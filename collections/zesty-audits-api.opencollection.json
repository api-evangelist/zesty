{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zesty Accounts Apps Audits API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Audits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zesty List audit trail entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/env/audits",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of entries to return."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of audit trail entries recording actions taken on the instance."
        }
      ]
    }
  ],
  "bundled": true
}