{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zesty Accounts Apps Stylesheets API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Stylesheets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zesty List all stylesheets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/web/stylesheets",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of all stylesheet files in the instance."
        },
        {
          "info": {
            "name": "Zesty Create a stylesheet",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.api.zesty.io/v1/web/stylesheets",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new stylesheet file in the instance."
        },
        {
          "info": {
            "name": "Zesty Get a stylesheet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/web/stylesheets/:stylesheetZUID",
            "params": [
              {
                "name": "stylesheetZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the stylesheet."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a specific stylesheet and its code content."
        },
        {
          "info": {
            "name": "Zesty Update a stylesheet",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://accounts.api.zesty.io/v1/web/stylesheets/:stylesheetZUID",
            "params": [
              {
                "name": "stylesheetZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the stylesheet."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Updates the code content of a specific stylesheet."
        }
      ]
    }
  ],
  "bundled": true
}