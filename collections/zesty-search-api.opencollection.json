{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zesty Accounts Apps Search API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zesty Search content items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/search/items",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "The search query string."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Searches across all content items in the instance."
        }
      ]
    }
  ],
  "bundled": true
}