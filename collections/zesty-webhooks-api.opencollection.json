{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zesty Accounts Apps Webhooks API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zesty List all webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/webhooks",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of all configured webhooks."
        },
        {
          "info": {
            "name": "Zesty Create a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.api.zesty.io/v1/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new webhook for event notifications."
        }
      ]
    }
  ],
  "bundled": true
}