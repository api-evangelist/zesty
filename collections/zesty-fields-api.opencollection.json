      "items": [
        {
          "info": {
            "name": "Zesty List fields for a content model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/content/models/:modelZUID/fields",
            "params": [
              {
                "name": "modelZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the content model."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns all fields defined for the specified content model."
        },
        {
          "info": {
            "name": "Zesty Create a field on a content model",
            "type": "http"
          },
          "http": {
