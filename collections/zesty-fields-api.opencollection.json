                "name": "modelZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the content model."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Adds a new field to the specified content model."
