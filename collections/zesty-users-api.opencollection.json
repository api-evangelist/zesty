{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zesty Accounts Apps Users API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zesty List all users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/users",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of all users in the account."
        },
        {
          "info": {
            "name": "Zesty Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/users/:userZUID",
            "params": [
              {
                "name": "userZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the user."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns details for a specific user by their ZUID."
        },
        {
          "info": {
            "name": "Zesty Update a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://accounts.api.zesty.io/v1/users/:userZUID",
            "params": [
              {
                "name": "userZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the user."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Updates the details of a specific user."
        },
        {
          "info": {
            "name": "Zesty Delete a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accounts.api.zesty.io/v1/users/:userZUID",
            "params": [
              {
                "name": "userZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the user."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a specific user."
        }
      ]
    }
  ],
  "bundled": true
}