{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zesty Accounts Apps Head Tags API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Head Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zesty List all head tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/web/headtags",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of all HTML head tags in the instance."
        },
        {
          "info": {
            "name": "Zesty Create a head tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accounts.api.zesty.io/v1/web/headtags",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new HTML head tag entry for the instance."
        },
        {
          "info": {
            "name": "Zesty Get a head tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accounts.api.zesty.io/v1/web/headtags/:headTagZUID",
            "params": [
              {
                "name": "headTagZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the head tag."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a specific head tag."
        },
        {
          "info": {
            "name": "Zesty Update a head tag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://accounts.api.zesty.io/v1/web/headtags/:headTagZUID",
            "params": [
              {
                "name": "headTagZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the head tag."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Updates a specific head tag."
        },
        {
          "info": {
            "name": "Zesty Delete a head tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accounts.api.zesty.io/v1/web/headtags/:headTagZUID",
            "params": [
              {
                "name": "headTagZUID",
                "value": "",
                "type": "path",
                "description": "The ZUID of the head tag."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Deletes a specific head tag."
        }
      ]
    }
  ],
  "bundled": true
}